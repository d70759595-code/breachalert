# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/breachalert

# Redis (cache + BullMQ queue)
REDIS_URL=redis://localhost:6379

# JWT signing secret (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-string

# Public URL of the API (used in verification email links)
APP_BASE_URL=http://localhost:3000

# Optional: Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: breach API (defaults to XposedOrNot — no key required)
# HIBP_API_KEY=your-haveibeenpwned-api-key

# Optional: real email delivery
# SENDGRID_API_KEY=
# MAILGUN_API_KEY=

# Optional: Stripe (not yet implemented)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

PORT=3000
